# Required by the browser and server Supabase clients.
# Set the same two values in GitHub Actions repository secrets for CI build.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Development-only Fast Login accounts.
# Each email must already exist in Supabase Auth and have a matching public.profiles row.
# Keep these server-only and never commit real values.
FAST_LOGIN_USER_EMAIL=
FAST_LOGIN_USER_PASSWORD=
FAST_LOGIN_INTERPRETER_EMAIL=
FAST_LOGIN_INTERPRETER_PASSWORD=
FAST_LOGIN_MANAGER_EMAIL=
FAST_LOGIN_MANAGER_PASSWORD=
FAST_LOGIN_ADMIN_EMAIL=
FAST_LOGIN_ADMIN_PASSWORD=
