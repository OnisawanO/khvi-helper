NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server only. Required for permanent account deletion. Never prefix this key
# with NEXT_PUBLIC_ and never expose it in browser code.
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Development-only Fast Login accounts.
FAST_LOGIN_USER_EMAIL=
FAST_LOGIN_USER_PASSWORD=
FAST_LOGIN_INTERPRETER_EMAIL=
FAST_LOGIN_INTERPRETER_PASSWORD=
FAST_LOGIN_MANAGER_EMAIL=
FAST_LOGIN_MANAGER_PASSWORD=
FAST_LOGIN_ADMIN_EMAIL=
FAST_LOGIN_ADMIN_PASSWORD=
